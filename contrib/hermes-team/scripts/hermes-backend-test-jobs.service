[Unit]
Description=Allowlisted offline backend test jobs for Hermes
After=hermes-rootless-test-docker.service
Requires=hermes-rootless-test-docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/alex/.local/share/hermes-test-runtime/tools/backend_test_jobs.py worker
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
UMask=0077
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
