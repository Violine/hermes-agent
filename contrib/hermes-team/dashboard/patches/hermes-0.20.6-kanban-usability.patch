 .hermes-kanban-trash-label {
   font-weight: 500;
 }
+
+/* ---- Operator readability pass -------------------------------------- */
+/* Dashboard themes can apply display fonts, tracking and forced uppercase
+   to every control. Keep the Kanban UI calm and legible regardless of the
+   selected dashboard theme, while leaving code/log payloads monospaced. */
+.hermes-kanban,
+.hermes-kanban :where(button, input, select, textarea, label, p, span, div,
+  h1, h2, h3, h4, summary, a, li, dt, dd) {
+  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
+    "Noto Sans", sans-serif !important;
+  letter-spacing: normal !important;
+  text-transform: none !important;
+}
+
+.hermes-kanban :where(button, input, select, textarea) {
+  font-size: 0.875rem;
+  line-height: 1.4;
+}
+
+.hermes-kanban :where(p, li, label, summary) {
+  font-size: 0.875rem;
+  line-height: 1.5;
+}
+
+.hermes-kanban :where(code, pre, kbd, samp),
+.hermes-kanban :where(.hermes-kanban-card-id, .hermes-kanban-lane-name,
+  .hermes-kanban-progress, .hermes-kanban-event-payload,
+  .hermes-kanban-run-id, .hermes-kanban-meta-value code) {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
+    "Liberation Mono", monospace !important;
+  letter-spacing: normal !important;
+  text-transform: none !important;
+}
+
+.hermes-kanban-column-label,
+.hermes-kanban-lane-head,
+.hermes-kanban-card-title,
+.hermes-kanban-card-meta,
+.hermes-kanban-drawer-head,
+.hermes-kanban-drawer-title,
+.hermes-kanban-diag-title {
+  letter-spacing: normal !important;
+  text-transform: none !important;
+}
+
+.hermes-kanban-column-label { font-size: 0.9rem; }
+.hermes-kanban-lane-head { font-size: 0.8rem; }
+.hermes-kanban-lane-name { font-size: 0.8rem; }
+.hermes-kanban-card-title { font-size: 0.9rem; line-height: 1.4; }
+.hermes-kanban-card-meta { font-size: 0.78rem; line-height: 1.4; }
+.hermes-kanban-card-id { font-size: 0.72rem; }
+.hermes-kanban-drawer-head { font-size: 0.8rem; }
+.hermes-kanban-drawer-title { font-size: 1.125rem; line-height: 1.35; }
+.hermes-kanban-drawer-body { gap: 0.7rem; }
+
+/* Compact, readable operator summary at the start of a task drawer. */
+.hermes-kanban-operator-status {
+  --operator-accent: var(--color-muted-foreground, #8b95a5);
+  display: grid;
+  gap: 0.3rem;
+  padding: 0.8rem 0.9rem;
+  border: 1px solid color-mix(in srgb, var(--operator-accent) 38%, var(--color-border));
+  border-left: 4px solid var(--operator-accent);
+  border-radius: var(--radius, 0.5rem);
+  background: color-mix(in srgb, var(--operator-accent) 7%, var(--color-card));
+  color: var(--color-foreground);
+  font-size: 0.9rem;
+  line-height: 1.5;
+  overflow-wrap: anywhere;
+}
+.hermes-kanban-operator-status--warning { --operator-accent: #d29527; }
+.hermes-kanban-operator-status--error { --operator-accent: #d34b4b; }
+.hermes-kanban-operator-status--info { --operator-accent: #4487c5; }
+.hermes-kanban-operator-status--success { --operator-accent: #328b60; }
+.hermes-kanban-operator-status__title {
+  font-size: 0.98rem;
+  line-height: 1.35;
+  font-weight: 700;
+  color: var(--color-foreground);
+}
+.hermes-kanban-operator-status__reason,
+.hermes-kanban-operator-status__action {
+  font-size: 0.875rem;
+  line-height: 1.5;
+  color: var(--color-foreground);
+  overflow-wrap: anywhere;
+}
+.hermes-kanban-operator-status__action { font-weight: 600; }
+
+.hermes-kanban-card-state {
+  display: block;
+  margin-top: 0.2rem;
+  padding: 0.35rem 0.5rem;
+  border-left: 3px solid var(--color-muted-foreground, #8b95a5);
+  border-radius: 0.25rem;
+  background: color-mix(in srgb, var(--color-foreground) 5%, transparent);
+  color: var(--color-foreground);
+  font-size: 0.78rem;
+  line-height: 1.4;
+  overflow-wrap: anywhere;
+}
+.hermes-kanban-card-state--warning { border-left-color: #d29527; }
+.hermes-kanban-card-state--error { border-left-color: #d34b4b; }
+.hermes-kanban-card-state--info { border-left-color: #4487c5; }
+.hermes-kanban-card-state--success { border-left-color: #328b60; }
+
+/* Long instructions, raw events and worker output stay available, but do
+   not dominate the initial view of a task. */
+.hermes-kanban-disclosure {
+  min-width: 0;
+  border: 1px solid var(--color-border);
