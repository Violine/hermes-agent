+          title: tx(t, "projectDirectoryHelp", "Project directory on the Hermes server"),
+          className: "h-8",
+          style: { minWidth: 0, flex: 1 },
+          disabled: props.disabled,
+          autoCapitalize: "none", autoCorrect: "off", spellCheck: false,
+        }),
