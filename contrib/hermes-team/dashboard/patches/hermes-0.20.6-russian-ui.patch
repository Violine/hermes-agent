+  function pluralRu(n, forms) {
+    const value = Math.abs(Number(n) || 0);
+    const mod10 = value % 10;
+    const mod100 = value % 100;
+    const index = mod10 === 1 && mod100 !== 11 ? 0
+      : mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14) ? 1 : 2;
+    return `${n} ${forms[index]}`;
+  }
