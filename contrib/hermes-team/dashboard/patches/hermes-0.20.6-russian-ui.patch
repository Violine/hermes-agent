+  const CATEGORY_KEYS = {
+    "Agent Autonomy": "agent_autonomy",
+    "Debugging Chaos": "debugging_chaos",
+    "Vibe Coding": "vibe_coding",
+    "Hermes Native": "hermes_native",
+    "Research/Web": "research_web",
+    "Tool Mastery": "tool_mastery",
+    "Model Lore": "model_lore",
+    "Lifestyle": "lifestyle",
+  };
+
+  function tierText(t, tier) {
+    if (!tier) return tier;
+    const key = String(tier).toLowerCase();
+    return tx(t, "tiers." + key, tier);
+  }
+
+  function metricText(t, metric) {
+    if (!metric) return "";
+    const fallback = String(metric).replace(/_/g, " ");
+    return tx(t, "criteria.metrics." + metric, fallback);
+  }
+
+  function criteriaText(t, achievement) {
+    // The API deliberately emits only generic copy for an undiscovered
+    // secret. Never inspect or render its raw requirement fields here.
+    if (achievement.state === "secret") {
+      return tx(t, "criteria.secret", "Secret: keep using Hermes in different workflows to reveal this achievement.");
+    }
+    const prefix = tx(t, "criteria.prefix", "Requirement");
+    if (achievement.threshold_metric) {
+      const ladder = (achievement.tiers || []).slice().sort(function (a, b) {
+        return a.threshold - b.threshold;
+      }).map(function (tier) {
+        return tierText(t, tier.name) + " " + Number(tier.threshold).toLocaleString();
+      }).join(", ");
+      return tx(t, "criteria.tiered", "{prefix}: {metric}. Tier ladder: {ladder}.", {
+        prefix: prefix,
+        metric: metricText(t, achievement.threshold_metric),
+        ladder: ladder,
+      });
+    }
+    const requirements = achievement.requirements || [];
+    if (requirements.length) {
+      const list = requirements.map(function (requirement) {
+        return metricText(t, requirement.metric) + " ≥ " + Number(requirement.gte || 1).toLocaleString();
+      }).join("; ");
+      return tx(t, "criteria.multiple", "{prefix}: {requirements}.", {
+        prefix: prefix,
+        requirements: list,
+      });
+    }
+    return tx(t, "criteria.behavior", "{prefix}: complete the matching Hermes behavior.", { prefix: prefix });
+  }
+
+  function displayAchievement(t, achievement, locale) {
+    const useRussian = /^ru(?:[-_]|$)/i.test(locale || "");
+    const categoryKey = CATEGORY_KEYS[achievement.category];
+    if (achievement.state === "secret") {
+      return Object.assign({}, achievement, {
+        display_name: "???",
+        display_description: tx(t, "secret.description", "Secret achievement: hidden until Hermes detects the first relevant behavior in your session history."),
+        display_category: categoryKey ? tx(t, "categories." + categoryKey, achievement.category) : achievement.category,
+        display_criteria: useRussian ? criteriaText(t, achievement) : achievement.criteria,
+      });
+    }
+    return Object.assign({}, achievement, {
+      display_name: tx(t, "items." + achievement.id + ".name", achievement.name),
+      display_description: tx(t, "items." + achievement.id + ".description", achievement.description),
+      display_category: categoryKey ? tx(t, "categories." + categoryKey, achievement.category) : achievement.category,
+      display_tier: tierText(t, achievement.tier),
+      display_next_tier: tierText(t, achievement.next_tier),
+      display_criteria: useRussian ? criteriaText(t, achievement) : achievement.criteria,
+    });
+  }
